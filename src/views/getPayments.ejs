<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registros de Pagos</title>
    <link rel="stylesheet" href="/css/table.css">
        <link rel="stylesheet" href="css/estilos.css">    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* Estilos adicionales específicos para pagos */
        .card-number {
            font-family: 'Courier New', monospace;
            letter-spacing: 1px;
        }
        
        .card-details {
            display: flex;
            gap: 0.5rem;
            align-items: center;
        }
        
        .card-expiry {
            white-space: nowrap;
        }
        
        .currency {
            font-weight: 500;
            color: #27ae60;
        }
        
        .card-type {
            margin-left: 0.5rem;
            color: #7f8c8d;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
            <nav style="background-color: #3498db;" >
            <a href="/">inicio</a>
            <a href="/getPayment">Pagos</a>
            <a href="/admin/contacts">contactos</a>
            <a href="/login?form=login">Login</a>
            <%if(isAdmin){%>
                <a href="/logout">contactos</a>
                <%}%>
        </nav>

        <form id="filterForm" class="mb-6 w-full max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
  <input id="searchInput" type="text" placeholder="Buscar por nombre o correo" class="col-span-1 md:col-span-2 px-4 py-2 border rounded-lg w-full" />
  
  <select id="estadoSelect" class="px-4 py-2 border rounded-lg">
    <option value="">Todos los estados</option>
    <option value="aprobado">Aprobado</option>
    <option value="rechazado">Rechazado</option>
    <option value="pendiente">Pendiente</option>
  </select>

  <select id="servicioSelect" class="px-4 py-2 border rounded-lg">
    <option value="">Todos los servicios</option>
    <option value="Suscripción Mensual">Suscripción Mensual</option>
    <option value="Suscripción Anual">Suscripción Anual</option>
    <!-- agrega más según tus servicios -->
  </select>

  <input type="date" id="fechaInicio" class="px-4 py-2 border rounded-lg" />
  <input type="date" id="fechaFin" class="px-4 py-2 border rounded-lg" />

</form>

<div id="contactsContainer" >
    <div class="contacts-container">
        <div class="contacts-header">
            <h1 class="contacts-title">Registros de Pagos <i class="fas fa-credit-card"></i></h1>
            <span>Total:<%=datePayments.length%></span>
        </div>

        <% if (datePayments.length > 0) { %>
            <table class="contacts-table">
                <thead>
                    <tr>
                        <th>Titular</th>
                        <th>Correo</th>
                        <th>Descripcion</th>
                        <th>Tarjeta</th>
                        <th>Expiración</th>
                        <th>Moneda</th>
                        <th>Monto</th>
                        <th>Referencia</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    <% datePayments.forEach(payment => { %>
                        <tr>
                            <td data-label="Titular"><%= payment.nombreTitular %></td>
                            <td data-label="Correo" class="contact-email"><%= payment.correo %></td>
                            <td data-label="Correo" class="contact-email"><%= payment.descripcion %></td>
                            <td data-label="Tarjeta">
                                <div class="card-details">
                                    <span class="card-number">•••• •••• •••• <%= payment.cardNumber.slice(-4) %></span>
                                    <span class="card-type">
                                        <% if (['4'].includes(payment.cardNumber.charAt(0))) { %>
                                            <i class="fab fa-cc-visa"></i>
                                        <% } else if (['5'].includes(payment.cardNumber.charAt(0))) { %>
                                            <i class="fab fa-cc-mastercard"></i>
                                        <% } else if (['3'].includes(payment.cardNumber.charAt(0))) { %>
                                            <i class="fab fa-cc-amex"></i>
                                        <% } else { %>
                                            <i class="fas fa-credit-card"></i>
                                        <% } %>
                                    </span>
                                </div>
                            </td>
                            <td data-label="Expiración" class="card-expiry">
                                <%= payment.expMonth %>/<%= payment.expYear.toString().slice(-2) %>
                            </td>
                            <td data-label="Moneda" class="currency">
                                <% if (payment.currency === 'USD') { %>
                                    $ USD
                                <% } else if (payment.currency === 'EUR') { %>
                                    € EUR
                                <% } else if (payment.currency === 'GBP') { %>
                                    £ GBP
                                <% } else { %>
                                    <%= payment.currency %>
                                <% } %>
                            </td>
                            <td>
                                <%=payment.amount%>
                            </td>
                            <td>
                                <%=payment.reference%>
                            </td>
                            <td data-label="Fecha" class="contact-date">
                                <%= new Date(payment.createdAt).toLocaleDateString() %>
                                <br>
                                <%= new Date(payment.createdAt).toLocaleTimeString() %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <p>No hay registros de pagos disponibles.</p>
        <% } %>
    </div>
    </div>
 <script src="/js/filterPayment.js"></script>
</body>
</html>