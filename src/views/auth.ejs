<!DOCTYPE html>
<html lang="<%= locale || 'es' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= __('auth.page_title') %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="js/alertConfig.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'dark-bg': '#0f172a',
            'dark-card': '#1e293b',
            'dark-input': '#334155',
            'dark-border': '#475569',
            'dark-text': '#e2e8f0',
            'dark-muted': '#94a3b8',
            'accent-blue': '#3b82f6',
            'accent-hover': '#2563eb'
          }
        }
      }
    }
  </script>
</head>
<body class="bg-dark-bg min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md">
    <!-- Language Selector -->
    <div class="mb-6 flex justify-center">
      <div class="bg-dark-card rounded-lg p-1 flex gap-1">
        <a href="/login?form=<%= formType %>&lang=es" 
           class="px-3 py-1 rounded-md text-sm transition-colors <%= locale === 'es' ? 'bg-accent-blue text-white' : 'text-dark-muted hover:text-dark-text' %>">
          🇪🇸 <%= __('auth.spanish') %>
        </a>
        <a href="/login?form=<%= formType %>&lang=en" 
           class="px-3 py-1 rounded-md text-sm transition-colors <%= locale === 'en' ? 'bg-accent-blue text-white' : 'text-dark-muted hover:text-dark-text' %>">
          🇺🇸 <%= __('auth.english') %>
        </a>
      </div>
    </div>

    <!-- Auth Container -->
    <div class="bg-dark-card rounded-xl shadow-2xl p-8 border border-dark-border">
      <!-- Form Switcher -->
      <div class="flex mb-8 bg-dark-bg rounded-lg p-1">
        <button 
          class="flex-1 py-2 px-4 rounded-md text-sm font-medium transition-all duration-200 <%= formType === 'login' ? 'bg-accent-blue text-white shadow-lg' : 'text-dark-muted hover:text-dark-text' %>" 
          onclick="switchForm('login')"
        >
          <%= __('auth.login_tab') %>
        </button>
        <button 
          class="flex-1 py-2 px-4 rounded-md text-sm font-medium transition-all duration-200 <%= formType === 'register' ? 'bg-accent-blue text-white shadow-lg' : 'text-dark-muted hover:text-dark-text' %>" 
          onclick="switchForm('register')"
        >
          <%= __('auth.register_tab') %>
        </button>
      </div>

      <% if (formType === 'login') { %>
      <!-- Login Form -->
      <form id="formLogin" class="space-y-6">
        <h2 class="text-2xl font-bold text-dark-text text-center mb-6">
          <%= __('auth.login_title') %>
        </h2>

        <div class="space-y-4">
          <div>
            <label for="login-email" class="block text-sm font-medium text-dark-text mb-2">
              <%= __('auth.email_label') %>
            </label>
            <input 
              type="email" 
              id="login-email" 
              name="email" 
              required
              placeholder="<%= __('auth.email_placeholder') %>"
              class="w-full px-4 py-3 bg-dark-input border border-dark-border rounded-lg text-dark-text placeholder-dark-muted focus:outline-none focus:ring-2 focus:ring-accent-blue focus:border-transparent transition-all duration-200"
            >
          </div>

          <div>
            <label for="login-password" class="block text-sm font-medium text-dark-text mb-2">
              <%= __('auth.password_label') %>
            </label>
            <input 
              type="password" 
              id="login-password" 
              name="password" 
              required
              placeholder="<%= __('auth.password_placeholder') %>"
              class="w-full px-4 py-3 bg-dark-input border border-dark-border rounded-lg text-dark-text placeholder-dark-muted focus:outline-none focus:ring-2 focus:ring-accent-blue focus:border-transparent transition-all duration-200"
            >
          </div>
        </div>

        <!-- Google Login -->
        <a href="/auth/google" 
           class="w-full flex items-center justify-center gap-3 px-4 py-3 bg-white text-gray-700 rounded-lg border border-gray-300 hover:bg-gray-50 transition-all duration-200 group">
          <svg class="w-5 h-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <%= __('auth.google_login') %>
        </a>

        <button type="submit" 
                class="w-full py-3 px-4 bg-accent-blue hover:bg-accent-hover text-white font-medium rounded-lg transition-all duration-200 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-accent-blue focus:ring-offset-2 focus:ring-offset-dark-card">
          <%= __('auth.login_button') %>
        </button>
      </form>
      <% } else { %>
      <!-- Register Form -->
      <form id="formRegister" class="space-y-6">
        <h2 class="text-2xl font-bold text-dark-text text-center mb-6">
          <%= __('auth.register_title') %>
        </h2>

        <div class="space-y-4">
          <div>
            <label for="username" class="block text-sm font-medium text-dark-text mb-2">
              <%= __('auth.fullname_label') %>
            </label>
            <input 
              type="text" 
              id="username" 
              name="username" 
              required
              placeholder="<%= __('auth.fullname_placeholder') %>"
              class="w-full px-4 py-3 bg-dark-input border border-dark-border rounded-lg text-dark-text placeholder-dark-muted focus:outline-none focus:ring-2 focus:ring-accent-blue focus:border-transparent transition-all duration-200"
            >
          </div>

          <div>
            <label for="register-email" class="block text-sm font-medium text-dark-text mb-2">
              <%= __('auth.email_label') %>
            </label>
            <input 
              type="email" 
              id="register-email" 
              name="email" 
              required
              placeholder="<%= __('auth.email_placeholder') %>"
              class="w-full px-4 py-3 bg-dark-input border border-dark-border rounded-lg text-dark-text placeholder-dark-muted focus:outline-none focus:ring-2 focus:ring-accent-blue focus:border-transparent transition-all duration-200"
            >
          </div>

          <div>
            <label for="register-password" class="block text-sm font-medium text-dark-text mb-2">
              <%= __('auth.password_label') %>
            </label>
            <input 
              type="password" 
              id="register-password" 
              name="password_hash" 
              required
              placeholder="<%= __('auth.password_placeholder') %>"
              minlength="6"
              class="w-full px-4 py-3 bg-dark-input border border-dark-border rounded-lg text-dark-text placeholder-dark-muted focus:outline-none focus:ring-2 focus:ring-accent-blue focus:border-transparent transition-all duration-200"
            >
          </div>

          <div>
            <label for="register-confirm" class="block text-sm font-medium text-dark-text mb-2">
              <%= __('auth.confirm_password_label') %>
            </label>
            <input 
              type="password" 
              id="register-confirm" 
              name="passwordHash" 
              required
              placeholder="<%= __('auth.confirm_password_placeholder') %>"
              class="w-full px-4 py-3 bg-dark-input border border-dark-border rounded-lg text-dark-text placeholder-dark-muted focus:outline-none focus:ring-2 focus:ring-accent-blue focus:border-transparent transition-all duration-200"
            >
          </div>
        </div>

        <button type="submit" 
                class="w-full py-3 px-4 bg-accent-blue hover:bg-accent-hover text-white font-medium rounded-lg transition-all duration-200 transform hover:scale-105 focus:outline-none focus:ring-2 focus:ring-accent-blue focus:ring-offset-2 focus:ring-offset-dark-card">
          <%= __('auth.register_button') %>
        </button>
      </form>
      <% } %>
    </div>
  </div>

  <script>
    function switchForm(type) {
      const currentLang = new URLSearchParams(window.location.search).get('lang') || 'es';
      window.location.href = `/login?form=${type}&lang=${currentLang}`;
    }
  </script>

  <script>
    let data, formData;
    const formRegister = document.querySelector('#formRegister');
    if (formRegister) {
      formRegister.addEventListener('submit', e => {
        e.preventDefault();
        formData = new FormData(e.target);
        data = Object.fromEntries(formData.entries());
        fetch('/registerUser', {
          method: 'POST',
          headers: {
            "Content-type": "application/json"
          },
          body: JSON.stringify(data)
        })
        .then(res => res.json())
        .then(res => {
          Swal.fire(res.message);
        });
      });
    }
  </script>

  <script>
    const formLogin = document.querySelector('#formLogin');
    if (formLogin) {
      formLogin.addEventListener('submit', e => {
        e.preventDefault();
        formData = new FormData(e.target);
        data = Object.fromEntries(formData.entries());
        fetch('/loginPost', {
          method: 'POST',
          headers: {
            "Content-type": "application/json"
          },
          body: JSON.stringify(data)
        })
        .then(res => res.json())
        .then(res => {
          if (res.status) {
            Swal.fire(res.message).then(() => {
              window.location.href = '/admin/contacts';
            });
          } else {
            Swal.fire(res.message);
          }
        });
      });
    }
  </script>
</body>
</html>