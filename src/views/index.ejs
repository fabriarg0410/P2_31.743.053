<section class="contacto">
    <h2 class="titulo"><%= __('contact.title') %></h2>
    <form id="formulario">
        <label for="nombre"><%= __('contact.name') %>:</label>
        <input type="text" id="nombre" name="nombre" required>
        
        <label for="correo"><%= __('contact.email') %>:</label>
        <input type="email" id="email" name="email" required>

        <label for="mensaje"><%= __('contact.message') %>:</label>
        <textarea id="comentario" name="comentario" required></textarea>
        <div class="g-recaptcha" data-sitekey="<%=sitioKey%>"></div>
        <button type="submit"><%= __('contact.send') %></button>
    </form>
</section>
